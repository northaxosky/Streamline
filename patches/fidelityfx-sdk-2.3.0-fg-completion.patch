+static inline uint32_t ffxFsr3UpscalerGetDispatchColorFlags(uint64_t apiFlags)
+{
+    uint32_t flags = 0;
+    if (apiFlags & FFX_UPSCALE_FLAG_NON_LINEAR_COLOR_SRGB)
+        flags |= FFX_FSR3UPSCALER_DISPATCH_NON_LINEAR_COLOR_SRGB;
+    if (apiFlags & FFX_UPSCALE_FLAG_NON_LINEAR_COLOR_PQ)
+        flags |= FFX_FSR3UPSCALER_DISPATCH_NON_LINEAR_COLOR_PQ;
+    if (apiFlags & FFX_UPSCALE_FLAG_NON_LINEAR_COLOR_GAMMA_2_2)
+        flags |= FFX_FSR3UPSCALER_DISPATCH_NON_LINEAR_COLOR_GAMMA_2_2;
+    return flags;
+}
+
+static inline uint32_t ffxFsr3UpscalerGetInputColorTransferFunction(uint32_t dispatchFlags)
+{
+    if (dispatchFlags & FFX_FSR3UPSCALER_DISPATCH_NON_LINEAR_COLOR_GAMMA_2_2)
+        return 3u;
+    if (dispatchFlags & FFX_FSR3UPSCALER_DISPATCH_NON_LINEAR_COLOR_PQ)
+        return 2u;
+    if (dispatchFlags & FFX_FSR3UPSCALER_DISPATCH_NON_LINEAR_COLOR_SRGB)
+        return 1u;
+    return 0u;
+}
